{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 100,
  "tabWidth": 2,
  "useTabs": false,
  "semi": true,
  "singleQuote": false,
  "jsxSingleQuote": false,
  "trailingComma": "es5",
  "arrowParens": "always",
  "bracketSpacing": true,
  "bracketSameLine": false,
  "endOfLine": "lf",
  "insertFinalNewline": true,
  "ignorePatterns": [
    "node_modules/**",
    "dist/**",
    "build/**",
    ".spicetify/**",
    ".tmp/**",
    "coverage/**",
    ".preview/**",
    "_rollback-backups/**",
    ".zcode/**",
    ".impeccable/**"
  ]
}

# Dependencies and package-manager caches
node_modules/
.npm/
.cache/
*.tgz

# Extension builds and local Spicetify output
/dist/
/build/
.spicetify/

# Temporary builds, previews, and deployment backups
.tmp/
.preview/
_rollback-backups/

# Test coverage and compiler/linter caches
coverage/
.nyc_output/
*.lcov
*.tsbuildinfo
.eslintcache
.stylelintcache

# Logs and runtime diagnostics
logs/
*.log
pids/
*.pid
*.pid.lock
*.seed
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json
.node_repl_history

# Local environment and credentials; example files remain publishable
.env
.env.*
!.env.example
!.env.*.example

# Local assistant state
.claude/settings.local.json
.zcode/
.impeccable/
